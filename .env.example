# ─── 目標環境 ──────────────────────────────────────────────
# 後端 API base URL（無 /api/v1 前綴）
GOSPLIT_API_BASE=https://go-backend-api-605450358080.asia-east1.run.app

# 前端 UI base URL（本機起 python -m http.server 或 Go-Split-main dev server）
GOSPLIT_UI_BASE=http://localhost:8000

# doc.json 位置（讓 schemas.py 讀取做 jsonschema 驗證）
# 預設從 docs/doc.json 讀；下面路徑覆寫用
# GOSPLIT_DOC_JSON=/absolute/path/to/doc.json

# ─── API 契約測試身分注入 ─────────────────────────────────
# 三角色任選一種（cookie 或 token），沒設就 skip
# 以 curl / Playwright 手動登入後取得，例如：
# GOSPLIT_HOST_COOKIE="session=abc123; refresh=def456"
# 或
# GOSPLIT_HOST_TOKEN=eyJhbGciOiJI...

# GOSPLIT_HOST_COOKIE=
# GOSPLIT_HOST_TOKEN=
# GOSPLIT_CO_COOKIE=
# GOSPLIT_CO_TOKEN=
# GOSPLIT_MEMBER_COOKIE=
# GOSPLIT_MEMBER_TOKEN=

# ─── E2E storage_state 位置 ──────────────────────────────
# auth_setup.py 會把三份 Playwright storage_state 寫到這個目錄
GOSPLIT_STATE_DIR=/tmp/gosplit-states

# ─── CI 加速：完全 skip 需要真實 API 的測試 ──────────────
# 設為 1 讓所有 API 契約測試無條件 skip（跑純 unit）
# GOSPLIT_SKIP_LIVE_API=1
